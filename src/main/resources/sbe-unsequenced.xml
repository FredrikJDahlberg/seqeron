<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
    SBE schema for client → sequencer ingress messages, before sequencing.

    Union of every FIX admin and application message, each carrying one
    additional field the sequencer needs before it can stamp and republish
    the message as the matching sbe-sequenced.xml message:
        header — composite of sourceId (fixed constant identifying the
                 submitting FIX gateway *process*; configured at startup,
                 stable across restarts, unique across every gateway
                 instance sharing this cluster), connectionId (TCP
                 connection id at that gateway; routes the reply to the
                 right local connection — unique only within one gateway
                 process, never across processes) and sessionId (Aeron
                 Cluster client session id of the submitting connection)
    Field/type definitions and IDs otherwise mirror the FIX wire format
    directly (see fix-session.xml / fix-application.xml).

    Also carries two non-FIX lifecycle messages, ClientConnected and
    ClientDisconnected, marking when a TCP connection opens/closes at the
    FIX gateway. These have no FIX StandardHeader fields (no counterparty to
    address yet, or none left to address) — just the header composite, so
    the sequencer can order them alongside everything else that connection
    ever sent and republish them as sbe-sequenced.xml ClientConnected /
    ClientDisconnected.

    Design notes
    ────────────
    Template IDs equal the ASCII value of the FIX MsgType character (as in
    both source schemas); every id below is already distinct across the two:
        Heartbeat '0'=48   TestRequest  '1'=49   ResendRequest '2'=50
        Reject    '3'=51   SequenceReset'4'=52    Logout        '5'=53
        Logon     'A'=65   ExecutionReport '8'=56 NewOrderSingle 'D'=68
    ClientConnected/ClientDisconnected/PortfolioQueryRequest/PortfolioQueryReply
    aren't FIX messages, so they use small, non-ASCII-derived template ids
    instead (1/2/3/4), clear of that range. The Replayer replay-protocol control
    messages (ReplayRequest/Replaying/ReplayPending, 6/7/8) live here
    too — they are node-local control plane between a Replayer and its co-located
    app replicas, never sequenced, so they belong in this pre-sequencing schema
    rather than sbe-sequenced.xml (id 5 is left for LeadershipChanged, which is
    the mirror-image case: sequenced-only, so it exists only in sbe-sequenced.xml).
    The cluster life-cycle markers ClusterStarted/ClusterStopped (10/11) also use
    small ids; unlike the replay messages they are sequenced and echoed, so they
    appear in both schemas.

    The header field uses field id 20001 — well outside the FIX tag range —
    since it is gateway/transport metadata, not a FIX tag. sourceId/connectionId/
    sessionId are composite members, not separately-tagged fields, so they
    carry no field ids of their own.

    Field IDs equal the FIX tag number for an unambiguous FIX ↔ SBE mapping.

    Common session-context fields in every message (from StandardHeader):
        sender (49), target (56), seqNum (34), sendingTimeMs (52)
    BeginString (8), BodyLength (9) and CheckSum (10) are omitted; the SBE
    messageHeader and the Aeron channel together carry that context.

    Optional-field conventions
    ──────────────────────────
    uint32 absent   → nullValue="4294967295"
    uint8  absent   → nullValue="255"
    int64  absent   → default signed null (INT64_MIN); no explicit nullValue
    GapFillFlag / refMsgType absent → nullValue="0" (not a valid ASCII MsgType)
    single-char enums (Side/OrdType/TimeInForce/HandlInst/ExecType/OrdStatus)
                    → encodingType uint8, validValues are the ASCII code of
                      the FIX character; nullValue="0" where optional, since
                      0 is not a valid ASCII value for any of them
    char[N] absent  → byte[0] == 0x00; absence encoded in application layer
                      (&#x0; is illegal in XML 1.0, so no nullValue on char
                      arrays)
    varData absent  → length == 0
    price fields (decimal in fix-application.xml) → int64 mantissa, fixed
                      exponent -8 (scale 1e8); mirrors
                      org::limitless::simdifx::utils::FixedDecimal
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="org.limitless.phixeron.sbe.unsequenced"
                   id="200"
                   version="0"
                   description="Client-submitted (not yet sequenced) FIX admin + application messages for cluster ingress"
                   byteOrder="littleEndian">

    <types>

        <!-- SBE framing header required by all SBE codecs -->
        <composite name="messageHeader">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId"  primitiveType="uint16"/>
            <type name="schemaId"    primitiveType="uint16"/>
            <type name="version"     primitiveType="uint16"/>
        </composite>

        <!--
            Transport-level identity of the submitting connection, prepended
            to every message in this schema (see field "header" below).
        -->
        <composite name="header"
                   description="Identifies the submitting gateway process, TCP connection, and Aeron Cluster session for this message">
            <type name="sourceId"     primitiveType="int32"
                  description="Fixed constant identifying the submitting FIX gateway process; configured at startup, stable across restarts, unique across every gateway instance"/>
            <type name="connectionId" primitiveType="int32"
                  description="TCP connection id at that gateway process; routes the reply. Unique only within one gateway process, not across processes"/>
            <type name="sessionId"    primitiveType="int64"
                  description="Aeron Cluster client session id of the submitting connection"/>
        </composite>

        <!--
            Per-item basic-data load progress (see doc/basicdata-design.md §3):
            both counters count DOWN to 0. Composite members carry no field ids
            of their own, like the header composite.
        -->
        <composite name="basicDataProgress"
                   description="Per-item load progress; both count DOWN to 0. See doc/basicdata-design.md §3.">
            <type name="remainingSections" primitiveType="uint16"
                  description="Sections remaining after the current one; 0 = last section"/>
            <type name="remainingItems"    primitiveType="uint16"
                  description="Items remaining in this section after the current one; 0 = section complete"/>
        </composite>

        <!-- CompID: 16-char fixed (tags 49 / 56); byte[0]==0x00 signals absent, unused trailing bytes 0x00.
             Sized to hold real FIX comp-ids such as "SEQUENCER" (9 chars) without abbreviation. -->
        <type name="compId" primitiveType="char" length="16" characterEncoding="US-ASCII"
              description="SenderCompID or TargetCompID (tags 49/56); up to 16 chars, unused trailing bytes 0x00"/>

        <!--
            TestReqID: 32-char fixed (tag 112).
            byte[0] == 0x00 signals absent; see schema header comment.
        -->
        <type name="testReqId" primitiveType="char" length="32" characterEncoding="US-ASCII"
              description="TestReqID (tag 112); byte[0]==0x00 signals absent"/>

        <!-- UTC milliseconds since Unix epoch (maps to std::chrono::milliseconds) -->
        <type name="msTimestamp" primitiveType="int64" semanticType="UTCTimestamp"
              description="Sending time in milliseconds since 1970-01-01T00:00:00Z (tag 52)"/>

        <!-- Variable-length data for optional text and XML payloads; length 0 = absent -->
        <composite name="varDataEncoding">
            <type name="length"  primitiveType="uint16" nullValue="65535" presence="optional"/>
            <type name="varData" primitiveType="uint8"  length="0" characterEncoding="US-ASCII"/>
        </composite>

        <!--
            Fixed-point price: int64 mantissa, implied exponent -8 (scale 1e8).
            Mirrors org::limitless::simdifx::utils::FixedDecimal on the C++ side.
        -->
        <type name="price" primitiveType="int64" semanticType="Price"
              description="Fixed-point price; mantissa scaled by 1e8 (exponent -8)"/>

        <!-- Symbol: 8-char fixed, space-padded (tag 55) -->
        <type name="symbol" primitiveType="char" length="8" characterEncoding="US-ASCII"
              description="Symbol (tag 55); space-padded to 8 bytes"/>

        <!-- Account: 8-char fixed (tag 1); byte[0]==0x00 signals absent -->
        <type name="account" primitiveType="char" length="8" characterEncoding="US-ASCII"
              description="Account (tag 1); byte[0]==0x00 signals absent"/>

        <!--
            Client-assigned opaque id for PortfolioQueryRequest/PortfolioQueryReply
            (custom, not a FIX tag); echoed verbatim in the reply to correlate it
            with the originating request.
        -->
        <type name="correlationId" primitiveType="int64"
              description="Client-assigned id; echoed in PortfolioQueryReply to correlate request/response"/>

        <!-- ClOrdID/OrderID/ExecID: 20-char fixed (tags 11/37/17) -->
        <type name="orderRef" primitiveType="char" length="20" characterEncoding="US-ASCII"
              description="ClOrdID/OrderID/ExecID; byte[0]==0x00 signals absent where optional"/>

        <!-- Text: 64-char fixed (tag 58); byte[0]==0x00 signals absent -->
        <type name="text" primitiveType="char" length="64" characterEncoding="US-ASCII"
              description="Free text (tag 58); byte[0]==0x00 signals absent"/>

        <!--
            TradeDate (tag 75): epoch milliseconds at UTC midnight for the date.
            Mirrors org::limitless::simdifx::utils::dateOnlyToEpochUTC.
        -->
        <type name="dateOnlyMs" primitiveType="int64" semanticType="LocalMktDate"
              description="Epoch ms at UTC midnight (tag 75 TradeDate)"/>

        <!--
            MaturityTime (tag 1079): milliseconds since UTC midnight.
            Mirrors org::limitless::simdifx::utils::timeOnlyToMillis.
        -->
        <type name="timeOnlyMs" primitiveType="int64" semanticType="UTCTimeOnly"
              description="Milliseconds since UTC midnight (tag 1079 MaturityTime)"/>

        <!-- ── Enumerations — session (admin) ───────────────────────────────── -->

        <!-- EncryptMethod (tag 98): only None defined in FIXT -->
        <enum name="EncryptMethod" encodingType="uint8">
            <validValue name="None">0</validValue>
        </enum>

        <!-- SessionRejectReason (tag 373): optional fields use nullValue="255" -->
        <enum name="SessionRejectReason" encodingType="uint8">
            <validValue name="InvalidTagNumber"            description="tag 0">0</validValue>
            <validValue name="RequiredTagMissing"          description="tag 1">1</validValue>
            <validValue name="TagNotDefinedForMessageType" description="tag 2">2</validValue>
            <validValue name="UndefinedTag"                description="tag 3">3</validValue>
            <validValue name="TagSpecifiedWithoutValue"    description="tag 4">4</validValue>
            <validValue name="ValueIsIncorrect"            description="tag 5">5</validValue>
            <validValue name="IncorrectDataFormat"         description="tag 6">6</validValue>
            <validValue name="DecryptionProblem"           description="tag 7">7</validValue>
            <validValue name="SignatureProblem"            description="tag 8">8</validValue>
            <validValue name="CompIDProblem"               description="tag 9">9</validValue>
            <validValue name="SendingTimeAccuracyProblem"  description="tag 10">10</validValue>
            <validValue name="InvalidMsgType"              description="tag 11">11</validValue>
        </enum>

        <!--
            GapFillFlag (tag 123): encoded as uint8 so nullValue="0" is
            unambiguous (0 is not a valid ASCII flag value).
            Values mirror ASCII: 'Y'=89, 'N'=78.
        -->
        <enum name="GapFillFlag" encodingType="uint8">
            <validValue name="GapFillMessage" description="Y: filling a sequence gap">89</validValue>
            <validValue name="SequenceReset"  description="N: hard reset">78</validValue>
        </enum>

        <!--
            MessageType (tag 35 / tag 372): ASCII value of the FIX MsgType character.
            Used as the SBE templateId and as the type of refMsgType in Reject.
            nullValue="0" is unambiguous (0 is not a valid FIX MsgType character).
        -->
        <enum name="MessageType" encodingType="uint8">
            <validValue name="Heartbeat"       description="35=0">48</validValue>
            <validValue name="TestRequest"     description="35=1">49</validValue>
            <validValue name="ResendRequest"   description="35=2">50</validValue>
            <validValue name="Reject"          description="35=3">51</validValue>
            <validValue name="SequenceReset"   description="35=4">52</validValue>
            <validValue name="Logout"          description="35=5">53</validValue>
            <validValue name="ExecutionReport" description="35=8">56</validValue>
            <validValue name="Logon"           description="35=A">65</validValue>
            <validValue name="NewOrderSingle"  description="35=D">68</validValue>
        </enum>

        <!-- ── Enumerations — application (validValues are ASCII codes) ─────── -->

        <!-- Side (tag 54) -->
        <enum name="Side" encodingType="uint8">
            <validValue name="Buy"       description="1">49</validValue>
            <validValue name="Sell"      description="2">50</validValue>
            <validValue name="BuyMinus"  description="3">51</validValue>
            <validValue name="SellPlus"  description="4">52</validValue>
            <validValue name="SellShort" description="5">53</validValue>
        </enum>

        <!-- OrdType (tag 40) -->
        <enum name="OrdType" encodingType="uint8">
            <validValue name="Market"    description="1">49</validValue>
            <validValue name="Limit"     description="2">50</validValue>
            <validValue name="Stop"      description="3">51</validValue>
            <validValue name="StopLimit" description="4">52</validValue>
        </enum>

        <!-- TimeInForce (tag 59); optional, nullValue="0" -->
        <enum name="TimeInForce" encodingType="uint8">
            <validValue name="Day"               description="0">48</validValue>
            <validValue name="GoodTillCancel"     description="1">49</validValue>
            <validValue name="AtTheOpening"       description="2">50</validValue>
            <validValue name="ImmediateOrCancel"  description="3">51</validValue>
            <validValue name="FillOrKill"         description="4">52</validValue>
        </enum>

        <!-- HandlInst (tag 21) -->
        <enum name="HandlInst" encodingType="uint8">
            <validValue name="AutoPrivate" description="1">49</validValue>
            <validValue name="AutoPublic"  description="2">50</validValue>
            <validValue name="Manual"      description="3">51</validValue>
        </enum>

        <!-- ExecType (tag 150) -->
        <enum name="ExecType" encodingType="uint8">
            <validValue name="New"            description="0">48</validValue>
            <validValue name="DoneForDay"     description="3">51</validValue>
            <validValue name="Canceled"       description="4">52</validValue>
            <validValue name="Replaced"       description="5">53</validValue>
            <validValue name="PendingCancel"  description="6">54</validValue>
            <validValue name="Stopped"        description="7">55</validValue>
            <validValue name="Rejected"       description="8">56</validValue>
            <validValue name="Suspended"      description="9">57</validValue>
            <validValue name="PendingNew"     description="A">65</validValue>
            <validValue name="Calculated"     description="B">66</validValue>
            <validValue name="Expired"        description="C">67</validValue>
            <validValue name="Restated"       description="D">68</validValue>
            <validValue name="PendingReplace" description="E">69</validValue>
            <validValue name="Trade"          description="F">70</validValue>
            <validValue name="TradeCorrect"   description="G">71</validValue>
            <validValue name="TradeCancel"    description="H">72</validValue>
            <validValue name="OrderStatus"    description="I">73</validValue>
        </enum>

        <!-- OrdStatus (tag 39) -->
        <enum name="OrdStatus" encodingType="uint8">
            <validValue name="New"             description="0">48</validValue>
            <validValue name="PartiallyFilled" description="1">49</validValue>
            <validValue name="Filled"          description="2">50</validValue>
            <validValue name="DoneForDay"      description="3">51</validValue>
            <validValue name="Canceled"        description="4">52</validValue>
            <validValue name="Replaced"        description="5">53</validValue>
            <validValue name="PendingCancel"   description="6">54</validValue>
            <validValue name="Stopped"         description="7">55</validValue>
            <validValue name="Rejected"        description="8">56</validValue>
            <validValue name="Suspended"       description="9">57</validValue>
            <validValue name="PendingNew"      description="A">65</validValue>
            <validValue name="Calculated"      description="B">66</validValue>
            <validValue name="Expired"         description="C">67</validValue>
            <validValue name="PendingReplace"  description="E">69</validValue>
        </enum>

        <!-- RiskQueryStatus: outcome of a PortfolioQueryRequest (custom, not FIX-derived) -->
        <enum name="RiskQueryStatus" encodingType="uint8">
            <validValue name="Ok"          description="risk assessment computed">0</validValue>
            <validValue name="NoPositions" description="account has no open positions">1</validValue>
            <validValue name="Error"       description="risk engine evaluation failed">2</validValue>
        </enum>

    </types>

    <!-- ═══════════════════════════════════════════════════════════════════
         Logon  (FIX 35=A, template 65 = ASCII 'A')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="Logon" id="65" semanticType="A"
                 description="Session logon; sent by initiator and echoed by acceptor">
        <field name="header"            id="20001" type="header"/>
        <field name="sender"            id="49"  type="compId"/>
        <field name="target"            id="56"  type="compId"/>
        <field name="seqNum"            id="34"  type="uint32"/>
        <field name="sendingTimeMs"     id="52"  type="msTimestamp"/>
        <field name="encryptMethod"     id="98"  type="EncryptMethod"/>
        <field name="heartbeatInterval" id="108" type="uint32"
               description="Negotiated heartbeat interval in milliseconds (HeartBtInt tag 108)"/>
        <field name="defaultApplVerID"  id="1137" type="uint8"
               description="FIXT.1.1 DefaultApplVerID (tag 1137); application version for the session (e.g. 6 = FIX.4.4). Always set by the gateway once validated at the edge"/>
        <data  name="xmlData"           id="213" type="varDataEncoding"
               description="Optional XML payload (FIX tags 212/213); length 0 = absent"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         Logout  (FIX 35=5, template 53 = ASCII '5')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="Logout" id="53" semanticType="5"
                 description="Session logout; either side may initiate">
        <field name="header"        id="20001" type="header"/>
        <field name="sender"        id="49" type="compId"/>
        <field name="target"        id="56" type="compId"/>
        <field name="seqNum"        id="34" type="uint32"/>
        <field name="sendingTimeMs" id="52" type="msTimestamp"/>
        <data  name="text"          id="58" type="varDataEncoding"
               description="Optional free-text reason (tag 58); length 0 = absent"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         Heartbeat  (FIX 35=0, template 48 = ASCII '0')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="Heartbeat" id="48" semanticType="0"
                 description="Liveness pulse; echoes TestReqID when responding to a TestRequest">
        <field name="header"        id="20001" type="header"/>
        <field name="sender"        id="49"  type="compId"/>
        <field name="target"        id="56"  type="compId"/>
        <field name="seqNum"        id="34"  type="uint32"/>
        <field name="sendingTimeMs" id="52"  type="msTimestamp"/>
        <field name="testReqID"     id="112" type="testReqId"
               description="Echoed from TestRequest; byte[0]==0x00 = spontaneous heartbeat"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         TestRequest  (FIX 35=1, template 49 = ASCII '1')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="TestRequest" id="49" semanticType="1"
                 description="Liveness probe; counterparty must echo TestReqID in a Heartbeat">
        <field name="header"        id="20001" type="header"/>
        <field name="sender"        id="49"  type="compId"/>
        <field name="target"        id="56"  type="compId"/>
        <field name="seqNum"        id="34"  type="uint32"/>
        <field name="sendingTimeMs" id="52"  type="msTimestamp"/>
        <field name="testReqID"     id="112" type="testReqId"
               description="Opaque token; must be echoed verbatim in the responding Heartbeat"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         ResendRequest  (FIX 35=2, template 50 = ASCII '2')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="ResendRequest" id="50" semanticType="2"
                 description="Requests retransmission of messages in a detected sequence gap">
        <field name="header"        id="20001" type="header"/>
        <field name="sender"        id="49" type="compId"/>
        <field name="target"        id="56" type="compId"/>
        <field name="seqNum"        id="34" type="uint32"/>
        <field name="sendingTimeMs" id="52" type="msTimestamp"/>
        <field name="beginSeqNo"    id="7"  type="uint32"
               description="First missing sequence number (tag 7)"/>
        <field name="endSeqNo"      id="16" type="uint32"
               description="Last missing sequence number; 0 = open-ended (tag 16)"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         Reject  (FIX 35=3, template 51 = ASCII '3')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="Reject" id="51" semanticType="3"
                 description="Session-level rejection of a malformed or invalid inbound message">
        <field name="header"              id="20001" type="header"/>
        <field name="sender"              id="49"  type="compId"/>
        <field name="target"              id="56"  type="compId"/>
        <field name="seqNum"              id="34"  type="uint32"/>
        <field name="sendingTimeMs"       id="52"  type="msTimestamp"/>
        <field name="refSeqNum"           id="45"  type="uint32"
               description="Sequence number of the rejected message (tag 45)"/>
        <field name="refTagID"            id="371" type="uint32"
               presence="optional" nullValue="4294967295"
               description="Tag that caused the rejection; 0xFFFFFFFF = absent (tag 371)"/>
        <field name="refMsgType"          id="372" type="MessageType"
               presence="optional" nullValue="0"
               description="MsgType of the rejected message; 0 = absent (tag 372)"/>
        <field name="sessionRejectReason" id="373" type="SessionRejectReason"
               presence="optional" nullValue="255"
               description="Coded rejection reason; 255 = unspecified (tag 373)"/>
        <data  name="text"                id="58"  type="varDataEncoding"
               description="Optional free-text description (tag 58); length 0 = absent"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         SequenceReset  (FIX 35=4, template 52 = ASCII '4')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="SequenceReset" id="52" semanticType="4"
                 description="Resets inbound sequence number; gap-fill or hard reset">
        <field name="header"        id="20001" type="header"/>
        <field name="sender"        id="49"  type="compId"/>
        <field name="target"        id="56"  type="compId"/>
        <field name="seqNum"        id="34"  type="uint32"/>
        <field name="sendingTimeMs" id="52"  type="msTimestamp"/>
        <field name="gapFillFlag"   id="123" type="GapFillFlag"
               presence="optional" nullValue="0"
               description="89='Y' gap-fill, 78='N' hard reset, 0 = absent (tag 123)"/>
        <field name="newSeqNo"      id="36"  type="uint32"
               description="Next expected inbound sequence number after reset (tag 36)"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         ExecutionReport  (FIX 35=8, template 56 = ASCII '8')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="ExecutionReport" id="56" semanticType="8"
                 description="Reports the status of, or a fill against, an order">
        <field name="header"        id="20001" type="header"/>
        <field name="sender"        id="49"  type="compId"/>
        <field name="target"        id="56"  type="compId"/>
        <field name="seqNum"        id="34"  type="uint32"/>
        <field name="sendingTimeMs" id="52"  type="msTimestamp"/>
        <field name="orderID"       id="37"  type="orderRef"/>
        <field name="clOrdID"       id="11"  type="orderRef"
               description="byte[0]==0x00 signals absent"/>
        <field name="execID"        id="17"  type="orderRef"/>
        <field name="execType"      id="150" type="ExecType"/>
        <field name="ordStatus"     id="39"  type="OrdStatus"/>
        <field name="symbol"        id="55"  type="symbol"/>
        <field name="side"          id="54"  type="Side"/>
        <field name="orderQty"      id="38"  type="uint32"
               presence="optional" nullValue="4294967295"/>
        <field name="price"         id="44"  type="price" presence="optional"/>
        <field name="lastQty"       id="32"  type="uint32"
               presence="optional" nullValue="4294967295"/>
        <field name="lastPx"        id="31"  type="price" presence="optional"/>
        <field name="leavesQty"     id="151" type="uint32"/>
        <field name="cumQty"        id="14"  type="uint32"/>
        <field name="avgPx"         id="6"   type="price"/>
        <field name="transactTime"  id="60"  type="msTimestamp"/>
        <field name="text"          id="58"  type="text"
               description="byte[0]==0x00 signals absent"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         NewOrderSingle  (FIX 35=D, template 68 = ASCII 'D')
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="NewOrderSingle" id="68" semanticType="D"
                 description="Submits a new order to the counterparty">
        <field name="header"        id="20001" type="header"/>
        <field name="sender"        id="49"  type="compId"/>
        <field name="target"        id="56"  type="compId"/>
        <field name="seqNum"        id="34"  type="uint32"/>
        <field name="sendingTimeMs" id="52"  type="msTimestamp"/>
        <field name="account"       id="1"   type="account"
               description="byte[0]==0x00 signals absent"/>
        <field name="clOrdID"       id="11"  type="orderRef"/>
        <field name="handlInst"     id="21"  type="HandlInst"/>
        <field name="symbol"        id="55"  type="symbol"/>
        <field name="side"          id="54"  type="Side"/>
        <field name="transactTime"  id="60"  type="msTimestamp"/>
        <field name="orderQty"      id="38"  type="uint32"/>
        <field name="ordType"       id="40"  type="OrdType"/>
        <field name="price"         id="44"  type="price" presence="optional"/>
        <field name="timeInForce"   id="59"  type="TimeInForce"
               presence="optional" nullValue="0"/>
        <field name="text"          id="58"  type="text"
               description="byte[0]==0x00 signals absent"/>
        <field name="tradeDate"     id="75"  type="dateOnlyMs" presence="optional"/>
        <field name="maturityTime"  id="1079" type="timeOnlyMs" presence="optional"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         Lifecycle — not FIX messages; no StandardHeader fields, just header
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════════
         ClientConnected  (template 1)
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="ClientConnected" id="1"
                 description="A client opened a TCP connection to the FIX gateway">
        <field name="header" id="20001" type="header"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         ClientDisconnected  (template 2)
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="ClientDisconnected" id="2"
                 description="A client closed (or lost) its TCP connection to the FIX gateway">
        <field name="header" id="20001" type="header"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         Risk engine query/reply — not FIX messages; no StandardHeader fields
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════════════
         PortfolioQueryRequest  (template 3)
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="PortfolioQueryRequest" id="3"
                 description="Requests a risk assessment of an end user's portfolio; submitted to
                              cluster ingress like any other message and answered asynchronously,
                              on the global stream, by a PortfolioQueryReply from the risk engine
                              cluster client">
        <field name="header"        id="20001" type="header"/>
        <field name="correlationId" id="20002" type="correlationId"/>
        <field name="account"       id="1"     type="account"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         PortfolioQueryReply  (template 4)
         ═══════════════════════════════════════════════════════════════════ -->
    <sbe:message name="PortfolioQueryReply" id="4"
                 description="Risk engine's reply to a PortfolioQueryRequest. Submitted to cluster
                              ingress with header.sourceId/connectionId copied from the original
                              request so the FIX gateway can route it back to the requesting TCP
                              connection">
        <field name="header"        id="20001" type="header"/>
        <field name="correlationId" id="20002" type="correlationId"/>
        <field name="account"       id="1"     type="account"/>
        <field name="status"        id="20003" type="RiskQueryStatus"/>
        <field name="riskScore"     id="20004" type="uint32"
               description="Normalized risk score in [0,100] from the external risk engine; 0 when status != Ok"/>
        <field name="grossExposure" id="20005" type="price"
               description="Sum of abs(netQty * avgPx) across all positions in the account"/>
        <field name="netExposure"   id="20006" type="price"
               description="Sum of signed netQty * avgPx across all positions in the account"/>
        <field name="positionCount" id="20007" type="uint32"/>
        <data  name="text"          id="58"    type="varDataEncoding"
               description="Optional free-text detail, e.g. an error message when status=Error; length 0 = absent"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         Replay protocol  (templates 6/7/8) — node-local control plane between
         the node's Replayer and its co-located app replicas, over aeron:ipc. Never
         sequenced (no globalSeqNo), so they carry no `header` composite. See the
         Replayer design, doc/router-design.md §4. clientId identifies the
         requesting replica so the Replayer can cap concurrent replays at 2 (one
         in-flight per client) and the app can match a Replaying/ReplayPending reply
         to its own request; fromPosition is the recording position of the last
         in-order frame the app holds (SequencedEvent.position), which is the
         archive replay start — globalSeqNo stays the correctness key, position
         is only how the archive is addressed, so the Replayer needs no
         globalSeqNo->position index.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- App -> Replayer: "I have a gap; replay for me from fromPosition." -->
    <sbe:message name="ReplayRequest" id="6"
                 description="A replica asks its Replayer to replay the sequenced stream. Either it is
                              cold-starting and walks the full recording chain by segmentIndex, or it
                              detected a globalSeqNo gap and resumes the active recording at fromPosition">
        <field name="clientId"     id="20010" type="int32"
               description="Requesting replica's stable id, unique among the Replayer's co-located apps"/>
        <field name="fromPosition" id="20011" type="int64"
               description="Recording position to resume the active recording from (SequencedEvent.position
                            of the last in-order frame); used only when segmentIndex &lt; 0"/>
        <field name="segmentIndex" id="20014" type="int32"
               description="-1 = resume the current active recording at fromPosition (steady-state gap).
                            &gt;=0 = cold-start walk: replay the segmentIndex-th recording of the sequenced
                            stream's per-leader-tenure chain (oldest first) from position 0. The app walks
                            0,1,2,… de-duping by globalSeqNo (contiguous across tenures) until the Replayer
                            answers NO_REPLAY_NEEDED, which marks it caught up. This spans every failover,
                            so a cold start after a leader change recovers full history"/>
    </sbe:message>

    <!-- Replayer -> App: "A replay slot is free; attach to replaySessionId on the replay stream." -->
    <sbe:message name="Replaying" id="7"
                 description="The Replayer started an archive replay for the requesting replica; the app
                              attaches to replaySessionId on the Replayer replay stream and follows it until
                              its image position reaches catchUpPosition, then falls back to the live tap
                              (de-duped by globalSeqNo)">
        <field name="clientId"        id="20010" type="int32"/>
        <field name="replaySessionId" id="20012" type="int64"
               description="Aeron replay session id to attach to (Subscription.imageBySessionId) on the Replayer replay stream"/>
        <field name="catchUpPosition" id="20013" type="int64"
               description="Recording position the bounded replay ends at; the app is caught up once its
                            replay image reaches this and switches to the live tap. A bounded replay of an
                            active recording does not close its image at the bound, so completion is
                            detected by position (as GlobalStreamClient does for its live segment), not by
                            image close"/>
    </sbe:message>

    <!-- Replayer -> App: "All replay slots are busy; hold at your gap and wait." -->
    <sbe:message name="ReplayPending" id="8"
                 description="The Replayer has &gt;=2 replays already active; the requesting replica must hold
                              at its gap (must not advance past the hole) until a later Replaying arrives">
        <field name="clientId" id="20010" type="int32"/>
    </sbe:message>

    <!-- App -> Replayer: "I have caught up and am on the live tap; free my replay slot." -->
    <sbe:message name="ReplayComplete" id="9"
                 description="A replica has finished with its replay (caught up to the tip and switched to the
                              live tap) and no longer needs its slot; the Replayer frees it immediately (design
                              §5) rather than waiting for the idle-TTL, and hands it to any waiting app. Sent
                              after a steady-state gap resume; a cold-start walk needs none, since each of its
                              slots is freed by the supersede on the next segment request">
        <field name="clientId" id="20010" type="int32"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         Cluster life-cycle  (templates 10/11) — operator markers injected by
         clusterctl (org.limitless.phixeron.tool.ClusterCtl) to record the
         trading day's open/close in the ordered log. Submitted to cluster
         ingress like any other message, then sequenced and echoed on the global
         stream. Unlike ClientConnected/Disconnected they carry a correlationId
         (so clusterctl can match its own sequenced echo); unlike the
         replay-protocol control messages they *are* sequenced, so they exist in
         both schemas. No business body beyond correlationId.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- clusterctl -> cluster: "record that the system has started." -->
    <sbe:message name="ClusterStarted" id="10"
                 description="Operator marker recording that the cluster is up and open for the day;
                              published by clusterctl once an elected leader exists">
        <field name="header"        id="20001" type="header"/>
        <field name="correlationId" id="20002" type="correlationId"
               description="clusterctl-assigned id; echoed in the sequenced ClusterStarted so the tool matches its own marker"/>
    </sbe:message>

    <!-- clusterctl -> cluster: "record that the system is stopping." -->
    <sbe:message name="ClusterStopped" id="11"
                 description="Operator marker recording an orderly shutdown; the last business event in the
                              log. clusterctl aborts the cluster once it observes this message sequenced">
        <field name="header"        id="20001" type="header"/>
        <field name="correlationId" id="20002" type="correlationId"
               description="clusterctl-assigned id; echoed in the sequenced ClusterStopped so the tool matches its own marker"/>
    </sbe:message>

    <!-- ═══════════════════════════════════════════════════════════════════
         Basic data load  (templates 12–15) — reference data (valid FIX session
         comp-id pairs, the trading-day calendar) that the basic-data handler
         loads from the database once on the leader and republishes into the
         ordered log, so every replica and the FIX gateway build an identical
         reference-data view deterministically from the tap. A load is a
         bracketed, fixed-order run: StartBasicData, then each section's rows
         (both progress counters decrementing to 0), then EndBasicData. Like
         ClusterStarted/Stopped these are sequenced business events, so they
         exist in both schemas, byte-identical past the header composite.
         See doc/basicdata-design.md.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- StartBasicData (template 12) — opens a load; sent once (not re-sent on resume). -->
    <sbe:message name="StartBasicData" id="12"
                 description="Opens a basic-data load; sectionCount is the number of sections (tables) that follow">
        <field name="header"       id="20001" type="header"/>
        <field name="sectionCount" id="20020" type="uint16"/>
    </sbe:message>

    <!-- EndBasicData (template 13) — closes a load; the FIX gateway's readiness gate (design §6). -->
    <sbe:message name="EndBasicData" id="13"
                 description="Closes a basic-data load; the FIX gateway admits new logons only once it has observed this">
        <field name="header" id="20001" type="header"/>
    </sbe:message>

    <!-- BasicDataSession (template 14) — section: valid FIX session comp-id pairs (design §7). -->
    <sbe:message name="BasicDataSession" id="14"
                 description="One valid FIX session: the sender/target comp-id pair the gateway may admit">
        <field name="header"          id="20001" type="header"/>
        <field name="progress"        id="20021" type="basicDataProgress"/>
        <field name="sessionIdentity" id="20023" type="int32"/>
        <field name="senderComp"      id="20024" type="compId"/>
        <field name="targetComp"      id="20025" type="compId"/>
    </sbe:message>

    <!-- TradingDay (template 15) — section: calendar + open/close, HHMM as uint16. -->
    <sbe:message name="TradingDay" id="15"
                 description="One trading day: date plus open/close times (HHMM as uint16, e.g. 900 = 09:00, 1800 = 18:00)">
        <field name="header"      id="20001" type="header"/>
        <field name="progress"    id="20021" type="basicDataProgress"/>
        <field name="tradingDate" id="20026" type="dateOnlyMs"/>
        <field name="opening"     id="20027" type="uint16"/>
        <field name="closing"     id="20028" type="uint16"/>
    </sbe:message>

</sbe:messageSchema>
