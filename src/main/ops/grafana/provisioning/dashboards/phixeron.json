      "targets": [
        { "refId": "A", "expr": "rate(phixeron_sequencer_tap_backpressure_alerts_total[5m])", "legendFormat": "member {{member}}" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
