<Project Sdk="Microsoft.NET.Sdk">
  <!-- The client tier in C#: the port of seqeron-client/src/main/java, on Aeron.NET. -->
  <PropertyGroup>
    <AssemblyName>Org.Limitless.Seqeron</AssemblyName>
    <RootNamespace>Org.Limitless.Seqeron</RootNamespace>
    <PackageId>Org.Limitless.Seqeron</PackageId>
    <!-- The bridge between Agrona.NET's IDirectBuffer and the SBE runtime's DirectBuffer wraps a pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Description>The seqeron client tier: follow a seqeron cluster's ordered stream and submit to it, on Aeron.NET.</Description>
    <Authors>Fredrik Dahlberg</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/FredrikJDahlberg/seqeron</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FredrikJDahlberg/seqeron</RepositoryUrl>
    <PackageTags>aeron;sequencer;raft;sbe</PackageTags>
    <!-- XML docs for an IDE, as the javadoc jar is for Java. The generated codecs carry no comments, as in Java,
         where the schema documents them, so the missing-comment warning is off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- What Java leaves package-private, its tests reach; internal plus this is the C# equivalent. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Seqeron.Client.Tests" />
  </ItemGroup>

  <!-- Exact versions, as seqeron-bom's are enforced: spec V-1 makes them part of the wire format. -->
  <ItemGroup>
    <PackageReference Include="Aeron.Client" Version="[$(AeronDotnetVersion)]" />
    <PackageReference Include="Aeron.Cluster" Version="[$(AeronDotnetVersion)]" />
    <PackageReference Include="sbe-tool" Version="[$(SbeDotnetRuntimeVersion)]" />
  </ItemGroup>

  <!-- Committed codecs for sbe-frame.xml and sbe-replay.xml; regenerated by the Gradle
       generateCSharp*Sbe tasks and checked by checkCSharpSbeCurrent. -->
  <ItemGroup>
    <Compile Include="../generated/sbe/csharp/**/*.cs" LinkBase="Generated" />
  </ItemGroup>
</Project>
