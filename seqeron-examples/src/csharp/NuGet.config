<?xml version="1.0" encoding="utf-8"?>
<!-- `dotnet pack seqeron-client/src/main/csharp -o build/nuget` in the repo root puts seqeron here; Aeron.NET and
     the SBE runtime come from nuget.org, as the dependencies its package declares. -->
<configuration>
  <packageSources>
    <add key="seqeron-local" value="../../../build/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
