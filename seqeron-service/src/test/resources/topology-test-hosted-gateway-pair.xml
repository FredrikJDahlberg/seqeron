-->
<topology xmlns="http://limitless.org/seqeron/topology/1">
    <groups>
        <group name="test" id="1"/>
    </groups>

    <gateways>
        <gateway name="GW-H-A" id="10" sourceId="9" rank="0" group="test"
                 description="A hosted gateway, designated first"/>
        <gateway name="GW-H-B" id="11" sourceId="9" rank="1" group="test"
                 description="Its standby"/>
    </gateways>
</topology>
