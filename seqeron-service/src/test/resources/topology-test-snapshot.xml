<?xml version="1.0" encoding="UTF-8"?>
<!--
    The TestGateway pair of topology-test-gateway.xml and the TestApplication replicas, taking part in
    snapshot rounds every 2 s: what SnapshotTest loads (doc/snapshot.md).

      clusterctl.sh load-topology seqeron-service/src/test/resources/topology-test-snapshot.xml
-->
<topology xmlns="http://limitless.org/seqeron/topology/1">

    <!-- Every test topology declares the same groups, so any of them loads into a cluster another
         activated (spec S-8). -->
    <groups>
        <group name="test" id="1"/>
    </groups>

    <gateways>
        <gateway name="GW-T-A" id="10" sourceId="9" rank="0" group="test" snapshot="true"
                 description="TestGateway -Dprobe.snapshot=true"/>
        <gateway name="GW-T-B" id="11" sourceId="9" rank="1" group="test" snapshot="true"
                 description="TestGateway standby"/>
    </gateways>

    <applications>
        <application name="TestApplication" sourceId="16" group="test" snapshot="true"
                     description="TestApplication, one replica per member"/>
    </applications>

    <snapshots interval="2"/>

</topology>
