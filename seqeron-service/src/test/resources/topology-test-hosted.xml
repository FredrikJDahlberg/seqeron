<?xml version="1.0" encoding="UTF-8"?>
<!--
    The hosted-façade prototype's topology (doc/hosted-facade-draft.md): the TestApplication row, taking part in
    snapshot rounds every 2 s, and no gateway. HostedSnapshotTest loads it.
-->
<topology xmlns="http://limitless.org/seqeron/topology/1">
    <groups>
        <group name="test" id="1"/>
    </groups>

    <applications>
        <application name="TestApplication" sourceId="16" group="test" snapshot="true"
                     description="TestApplication replicas, one of them hosted"/>
    </applications>

    <snapshots interval="2"/>
</topology>
